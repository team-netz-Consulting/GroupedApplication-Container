# Nach .env kopieren (neben docker-compose.yml) und echte Werte eintragen - oder einfach
# "sudo ./install.sh" ausfuehren, das die .env mit sicheren Zufallswerten erzeugt.
# Die .env enthaelt die Geheimnisse dieser Installation und darf nie eingecheckt werden.

# Persistentes Host-Verzeichnis mit den Unterordnern mssql, uploads, logs und certs.
GROUPED_APP_DATA_ROOT=/opt/groupedapplication/data

# Freigegebene Image-Version. Fuer Kundeninstallationen immer einen festen Versionstag verwenden.
GROUPED_APP_IMAGE=ghcr.io/team-netz-consulting/groupedapplication
GROUPED_APP_IMAGE_TAG=2026.10.29.2

# Host-Port der Anwendung (im Container immer 8080). Davor gehoert ein TLS-Reverse-Proxy.
APP_PORT=8080
TZ=Europe/Berlin

# License Manager. Der Kundenname muss exakt dem Kunden der ausgestellten Lizenz entsprechen.
# Aktiviert wird die Lizenz nach der ersten Anmeldung unter /admin im Reiter "Lizenz".
LICENSE_MANAGER_BASE_URL=https://license.team-netz.net:5181
LICENSE_CUSTOMER_NAME=
LICENSE_MANAGER_ALLOW_INVALID_CERTIFICATE=false

# SQL-Server-Edition. Express genuegt innerhalb seiner Ressourcen- und Groessengrenzen.
MSSQL_PID=Express
# Mindestens 8 Zeichen mit Gross-/Kleinbuchstaben, Ziffer und Sonderzeichen.
DB_SA_PASSWORD=

# Pro Installation neu erzeugen, nie wiederverwenden: openssl rand -base64 48
JWT_SIGNING_KEY=

# Legt beim ersten Start einen SystemOwner an. Nach der ersten Anmeldung kann der Wert entfernt werden.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
